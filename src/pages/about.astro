---
// about.astro — the About page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Rainbow Static">

  <!-- Page header with dark background bar -->
  <div class="page-header" slot="header">
    <div class="page-header-content">
      <h1>About</h1>
    </div>
  </div>

  <!-- About content -->
  <div class="about-section">
    <div class="about-content">
      <p>
        Hi! Welcome to <strong>Rainbow Static</strong>. This site was created as a passion project for the WLW communityto share some of the great content I've discovered over the years. My hope is that having it all conveniently in one place will make it easier for others to find and enjoy these stories.
      </p>
      <strong>What you'll find here:</strong>
      <ul>
        <li>Thai GLs</li>
        <li>K-dramas </li>
        <li>Web series</li>
        <li>Classic WLW movies</li>
        <li>Music videos</li>
        <li>...and more as the library grows</li>
      </ul>
        </p>
        So, if you're looking for something gay to watch, I hope this helps. 
      </p>

       <p> With love, 
        <br /> <div class="signature"> Jen
      </div>
      </p>

    </div>
  </div>

</BaseLayout>

<style>
  /* Dark header bar — uses site variables instead of hardcoded colors */
  .page-header {
    background-color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

 .page-header-content {
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem;
}

  .page-header-content h1 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-bg); /* Light text on dark background */
    font-family: var(--font-heading); /* Use the display font for the header */
  }

  /* Wrapper for the about body content */
  .about-section {
    padding: 2rem 0; /* No side padding — page-wrapper in BaseLayout handles that */
  }

  .about-content {
    max-width: 680px;     /* Constrains line length for readability */
    margin: 0 auto;      /* Centers the content */
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-content p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
  }

  .about-content h2 {
    font-size: 1.2rem;
    color: var(--color-text);
    padding-left: 1rem;
    border-left: 4px solid var(--color-accent);
    border-radius: 0;
  }

  .about-content ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1rem;
  }

  /* Arrow bullet using ::before pseudo-element */
  .about-content ul li::before {
    content: "→ ";
    color: var(--color-accent);
  }

  .about-content ul li {
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .about-content strong {
    color: var(--color-text);
  }

  .signature {
    font-family: 'Tangerine', cursive;
    font-size: 2.5rem;
    color: var(--color-text);
    margin-top: -1.5rem;
    margin-left: 2rem;
  }
</style>