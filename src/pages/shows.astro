---
// shows.astro — the All Content page
// This page displays every show in the data file in a grid.

import BaseLayout from '../layouts/BaseLayout.astro';
import ShowCard from '../components/ShowCard.astro';

// Import all shows from our data file
import { shows } from '../data/shows.js';
---

<BaseLayout title="All Content — Rainbow Static">

  <!-- Page header with SMPTE bar accent -->
  <div class="page-header">

    <!-- Page title and show count -->
    <div class="page-header-content">
      <h1>All Content</h1>
      <!-- shows.length gives us the total number of shows in the array -->
      <p>{shows.length} shows and counting</p>
    </div>

  </div>

  <!-- Main content area -->
  <main>

    <!-- The grid of every show -->
    <div class="grid">
      {shows.map((show) => (
        <ShowCard {...show} />
      ))}
    </div>

  </main>

</BaseLayout>

<style>
  /* ============================================
     PAGE HEADER
     Dark background with the SMPTE stripe on top
     and the page title below it
  ============================================ */
  .page-header {
    background-color: #111111;
    border-bottom: 1px solid #222;
  }

  /* Page title and subtitle */
  .page-header-content {
    padding: 2rem;
  }

  .page-header-content h1 {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
  }

  /* Show count below the title */
  .page-header-content p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: #aaaaaa;
  }

  /* Main content padding */
  main {
    padding: 2rem;
  }

  /* Responsive grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
</style>