---
// about.astro — the About page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Rainbow Static">

  <!-- Page header with dark background bar -->
  <div class="page-header" slot="header">
    <div class="page-header-content">
      <h1>About</h1>
    </div>
  </div>

  <!-- About content -->
  <div class="about-section">
    <div class="about-content">

      <p>
        <strong>Rainbow Static</strong> is a community resource for anyone looking
        to find shows, series, and web series that feature WLW (women who love women)
        relationships — whether they're the main couple or a beloved side pairing.
      </p>

      <p>
        The name is a nod to the classic SMPTE color bars — the rainbow test pattern
        that appears on screens before a broadcast begins. We like to think of this
        site the same way: a signal that something good is about to start.
      </p>

      <h2>What you'll find here</h2>
      <ul>
        <li>Thai GL series</li>
        <li>Korean dramas with WLW storylines</li>
        <li>Western series and web series</li>
        <li>Anime and animated content</li>
        <li>And more as the library grows</li>
      </ul>

      <h2>Built by</h2>
      <p>
        Made with 🏳️‍🌈 by <strong>internetjen</strong> as a passion project
        for the WLW community.
      </p>

    </div>
  </div>

</BaseLayout>

<style>
  /* Dark header bar — uses site variables instead of hardcoded colors */
  .page-header {
    background-color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

 .page-header-content {
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem;
}

  .page-header-content h1 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-bg); /* Light text on dark background */
  }

  /* Wrapper for the about body content */
  .about-section {
    padding: 2rem 0; /* No side padding — page-wrapper in BaseLayout handles that */
  }

  .about-content {
    max-width: 680px;     /* Constrains line length for readability */
    margin: 0 auto;      /* Centers the content */
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-content p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
  }

  .about-content h2 {
    font-size: 1.2rem;
    color: var(--color-text);
    padding-left: 1rem;
    border-left: 4px solid var(--color-accent);
    border-radius: 0;
  }

  .about-content ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1rem;
  }

  /* Arrow bullet using ::before pseudo-element */
  .about-content ul li::before {
    content: "→ ";
    color: var(--color-accent);
  }

  .about-content ul li {
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .about-content strong {
    color: var(--color-text);
  }
</style>