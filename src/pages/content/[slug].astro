---
// [slug].astro — individual content page

import BaseLayout from '../../layouts/BaseLayout.astro';
import { tmdbSeriesIds, tmdbMovieIds, manualContent } from '../../data/content.js';
import { fetchSeriesList, fetchMovies } from '../../data/tmdb.js';

// Fetch and merge all content — same pattern as the other pages
const tmdbSeries = await fetchSeriesList(tmdbSeriesIds);
const tmdbMovies = await fetchMovies(tmdbMovieIds);
const allContent = [...tmdbSeries, ...tmdbMovies, ...manualContent];

// Astro calls getStaticPaths() to know which pages to build
// We generate one page per item using its slug as the URL
export async function getStaticPaths() {
  const tmdbSeries = await fetchSeriesList(tmdbSeriesIds);
  const tmdbMovies = await fetchMovies(tmdbMovieIds);
  const allContent = [...tmdbSeries, ...tmdbMovies, ...manualContent];

  return allContent
    .filter(Boolean)
    .map(item => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
const { title, year, country, genre, status, platform, image, description, type } = item;

// Determine where to watch link based on platform
const watchLinks: Record<string, string> = {
  'YouTube': `https://www.youtube.com/results?search_query=${encodeURIComponent(title)}`,
  'Netflix': 'https://www.netflix.com',
  'Viki': 'https://www.viki.com',
  'WeTV': 'https://wetv.vip',
  'iQIYI': 'https://www.iqiyi.com',
};

const watchLink = watchLinks[platform] ?? null;
---

<BaseLayout title={`${title} — Rainbow Static`}>

  <div class="page-header" slot="header">
    <div class="page-header-content">
      <a href="/content" class="back-link">← All Content</a>
    </div>
  </div>

  <div class="content-detail">

    <!-- Left column: poster -->
    <aside class="poster-col">
      {image
        ? <img src={image} alt={`Poster for ${title}`} class="poster" />
        : <div class="poster-placeholder">No Image</div>
      }
    </aside>

    <!-- Right column: all the info -->
    <div class="info-col">

      <div class="meta-top">
        <span class="badge">{type}</span>
        <span class="badge">{status}</span>
      </div>

      <h1>{title}</h1>

      <p class="meta">{year} · {country}</p>

      <div class="genre-list">
        {genre.map((g: string) => (
          <span class="genre-tag">{g}</span>
        ))}
      </div>

      {description && (
        <p class="description">{description}</p>
      )}

      <!-- Where to Watch -->
      <div class="watch-section">
        <h2>Where to Watch</h2>
        {watchLink
          ? (
            <a href={watchLink} target="_blank" rel="noopener noreferrer" class="watch-link">
              Watch on {platform} →
            </a>
          )
          : (
            <p class="watch-unknown">Available on {platform}</p>
          )
        }
      </div>

    </div>
  </div>

</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--color-bg);
    text-decoration: none;
    font-family: var(--font-body);
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .content-detail {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    padding: 3rem 0;
    align-items: start;
  }

  .poster {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .poster-placeholder {
    width: 100%;
    aspect-ratio: 2/3;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .meta-top {
    display: flex;
    gap: 0.5rem;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    background-color: #fff0f4;
    color: var(--color-accent);
    font-weight: 500;
    border: 1px solid #ffd0de;
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.1;
  }

  .meta {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .genre-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .genre-tag {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .description {
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.7;
    max-width: 600px;
  }

  .watch-section {
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .watch-section h2 {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .watch-link {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    background-color: var(--color-accent);
    color: #ffffff;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .watch-link:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .watch-unknown {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .content-detail {
      grid-template-columns: 1fr;
    }

    .poster {
      max-width: 240px;
    }
  }
</style>