---
// content.astro — the All Content page

import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { tmdbShowIds, tmdbMovieIds, manualContent } from '../data/content.js';
import { fetchShows, fetchMovies } from '../data/tmdb.js';

// Fetch all TMDB content at build time
// This runs on the server when Astro builds the page — not in the browser
const tmdbShows = await fetchShows(tmdbShowIds);
const tmdbMovies = await fetchMovies(tmdbMovieIds);

// Merge all content into one array
// TMDB content comes first, manual content fills in the rest
const content = [...tmdbShows, ...tmdbMovies, ...manualContent];

// Build filter options dynamically from the merged array — same as before
const types = [...new Set(content.map(item => item.type))].sort();
const countries = [...new Set(content.map(item => item.country))].sort();
const platforms = [...new Set(content.map(item => item.platform))].sort();
const statuses = [...new Set(content.map(item => item.status))].sort();
const genres = [...new Set(content.flatMap(item => item.genre))].sort();

---

<BaseLayout title="All Content — Rainbow Static">

  <div class="page-header" slot="header">
    <div class="page-header-content">
      <h1>All Content</h1>
      <p>{content.length} items and counting</p>
    </div>
  </div>

  <!-- Two-column layout: sidebar + grid -->
  <div class="content-layout">

    <!-- ---- SIDEBAR ---- -->
    <aside class="sidebar">

      <!-- Clear all filters button -->
      <!-- id="clear-filters" lets JavaScript find it easily -->
      <button id="clear-filters">Clear Filters</button>

      <!-- Each filter group follows the same pattern:
           a heading, then a list of checkboxes.
           data-filter="fieldname" tells our script which data attribute to check -->

      <div class="filter-group">
        <h3>Type</h3>
        {types.map(type => (
          <label>
            <input type="checkbox" data-filter="type" value={type} />
            {type}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Status</h3>
        {statuses.map(status => (
          <label>
            <input type="checkbox" data-filter="status" value={status} />
            {status}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Genre</h3>
        {genres.map(genre => (
          <label>
            <input type="checkbox" data-filter="genre" value={genre} />
            {genre}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Country</h3>
        {countries.map(country => (
          <label>
            <input type="checkbox" data-filter="country" value={country} />
            {country}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Platform</h3>
        {platforms.map(platform => (
          <label>
            <input type="checkbox" data-filter="platform" value={platform} />
            {platform}
          </label>
        ))}
      </div>

    </aside>

    <!-- ---- CARD GRID ---- -->
    <!-- id="content-grid" lets JavaScript find all the cards inside -->
    <div class="grid-wrapper">
      <div class="grid" id="content-grid">
        {content.map((item) => (
          <ContentCard {...item} />
        ))}
      </div>

      <!-- Shown when no cards match the active filters -->
      <p class="no-results" id="no-results" style="display: none;">
        No results match your filters. Try clearing some.
      </p>
    </div>

  </div>


  <script>
  // ---- GRAB ELEMENTS ----
  // Get all checkboxes, all cards, the grid, and the "no results" message
  const checkboxes = document.querySelectorAll('input[type="checkbox"]');
  const cards = document.querySelectorAll('#content-grid .card');
  const clearBtn = document.getElementById('clear-filters');
  const noResults = document.getElementById('no-results');

  // ---- CORE FILTER FUNCTION ----
  // Runs every time a checkbox is checked or unchecked
  function applyFilters() {

    // Build an object of active filters grouped by category
    // Example result: { type: ["Series"], country: ["Thailand", "South Korea"] }
    const active = {};

    checkboxes.forEach(checkbox => {
      if (checkbox.checked) {
        const category = checkbox.dataset.filter; // e.g. "type", "country"
        const value = checkbox.value;             // e.g. "Series", "Thailand"

        // If this category doesn't exist in active yet, create an empty array
        if (!active[category]) active[category] = [];

        // Add this value to that category's array
        active[category].push(value);
      }
    });

    // ---- SHOW/HIDE EACH CARD ----
    let visibleCount = 0;

    cards.forEach(card => {
      const matches = Object.entries(active).every(([category, selectedValues]) => {
        // Get this card's value for the current category
        // e.g. card.dataset.country = "Thailand"
        const cardValue = card.dataset[category] || '';

        // Genre is stored as a comma-separated string: "Romance,Drama"
        // So we split it back into an array to check membership
        const cardValues = cardValue.split(',');

        // Within the same category, OR logic:
        // at least one of the selected values must match the card
        return selectedValues.some(val => cardValues.includes(val));
      });

      // If no filters are active at all (active is empty), show everything
      const noFiltersActive = Object.keys(active).length === 0;

      if (noFiltersActive || matches) {
        card.style.display = '';  // show — empty string restores default display
        visibleCount++;
      } else {
        card.style.display = 'none';  // hide
      }
    });

    // Show "no results" message if everything is hidden
    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  // ---- LISTEN FOR CHECKBOX CHANGES ----
  // Every time any checkbox is toggled, re-run the filter
  checkboxes.forEach(checkbox => {
    checkbox.addEventListener('change', applyFilters);
  });

  // ---- CLEAR FILTERS BUTTON ----
  clearBtn.addEventListener('click', () => {
    // Uncheck every checkbox
    checkboxes.forEach(checkbox => {
      checkbox.checked = false;
    });
    // Re-run filter — with nothing checked, everything shows
    applyFilters();
  });
</script>

</BaseLayout>

<style>
  .page-header {
    background-color: #111111;
    border-bottom: 1px solid #222;
  }

  .page-header-content {
    padding: 2rem 0;
  }

  .page-header-content h1 {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
  }

  .page-header-content p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: #aaaaaa;
  }

  /* Two-column layout — sidebar left, grid right */
  .content-layout {
    display: grid;
    /* 220px for sidebar, rest for grid */
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    align-items: start; /* sidebar doesn't stretch to full height */
  }

  /* Sidebar stacks filter groups vertically */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    /* Sticks to top of viewport when scrolling */
    position: sticky;
    top: 88px; /* clears the navbar height */
  }

  #clear-filters {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    cursor: pointer;
    color: var(--color-muted);
    font-family: var(--font-body);
    transition: all 0.2s;
    width: fit-content;
  }

  #clear-filters:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Each filter group (Type, Country, etc.) */
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-group h3 {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }

  /* Each checkbox + label row */
  .filter-group label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .filter-group input[type="checkbox"] {
    accent-color: var(--color-accent); /* makes the checkbox pink when checked */
    width: 14px;
    height: 14px;
    cursor: pointer;
  }

  /* Card grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .no-results {
    color: var(--color-muted);
    font-size: 0.9rem;
    padding: 2rem 0;
  }

  /* On mobile, stack sidebar above grid */
  @media (max-width: 768px) {
    .content-layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static; /* unstick on mobile */
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .filter-group {
      min-width: 140px;
    }
  }
</style>