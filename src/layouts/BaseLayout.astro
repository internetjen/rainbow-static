---
const { title } = Astro.props;
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
  </head>

  <body>
    <Navbar />

    <!-- The Hero needs to be full-bleed (edge to edge), so it lives OUTSIDE the wrapper.
         We use Astro's named slots to pull it out separately. -->
    <slot name="hero" />
    <slot name="header" />  <!--  slot for full-width page headers -->


    <!-- Everything else (page content) goes inside this centered wrapper.
         max-width caps how wide it gets on large screens.
         margin: 0 auto centers it horizontally.
         padding adds breathing room on small screens so content doesn't touch the edges. -->
    <main class="page-wrapper">
      <slot />
    </main>

    <footer>
      <p>Made with 🏳️‍🌈 by internetjen</p>
    </footer>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --color-bg:       #f5f0eb;
    --color-surface:  #ffffff;
    --color-border:   #e0d8d0;
    --color-text:     #1a1a1a;
    --color-muted:    #8a8070;
    --color-accent:   #ff3d7f;
    --font-hero: 'Press Start 2P', system-ui;
    --font-tagline: 'VT323', monospace;
    --font-heading:   'nunito sans', sans-serif;
    --font-body:      'nunito sans', sans-serif;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  /* This wrapper constrains and centers all page content.
     The Hero is excluded because it needs to be full-width. */
  .page-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem; /* Side padding so content doesn't touch screen edges on mobile */
    position: relative; /* Establishes a new stacking context for the Hero's absolute positioning */
  }

  footer {
    text-align: center;
    padding: 2rem;
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
    color: var(--color-muted);
    font-family: var(--font-body);
  }
</style>