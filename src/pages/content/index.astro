---
// index.astro — the All Content page

import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { tmdbSeriesIds, tmdbMovieIds, manualContent } from '../../data/content.js';
import { fetchSeriesList, fetchMovies } from '../../data/tmdb.js';

// Fetch all TMDB content at build time
// This runs on the server when Astro builds the page — not in the browser
const tmdbSeries = await fetchSeriesList(tmdbSeriesIds);
const tmdbMovies = await fetchMovies(tmdbMovieIds);

// Merge all content into one array
// TMDB content comes first, manual content fills in the rest
const content = [...tmdbSeries, ...tmdbMovies, ...manualContent];

// Build filter options dynamically from the merged array
const types = [...new Set(content.map(item => item.type))].sort();
const countries = [...new Set(content.map(item => item.country))].sort();
const platforms = [...new Set(content.map(item => item.platform))].sort();
const statuses = [...new Set(content.map(item => item.status))].sort();
const genres = [...new Set(content.flatMap(item => item.genre))].sort();
---

<BaseLayout title="All Content — Rainbow Static">

  <div class="page-header" slot="header">
    <div class="page-header-content">
      <h1>All Content</h1>
      <p>{content.length} items</p>
    </div>
  </div>

  <!-- Two-column layout: sidebar + grid -->
  <div class="content-layout">

    <!-- ---- SIDEBAR ---- -->
    <aside class="sidebar">

      <button id="clear-filters">Clear Filters</button>

      <div class="filter-group">
        <h3>Type</h3>
        {types.map(type => (
          <label>
            <input type="checkbox" data-filter="type" value={type} />
            {type}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Status</h3>
        {statuses.map(status => (
          <label>
            <input type="checkbox" data-filter="status" value={status} />
            {status}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Genre</h3>
        {genres.map(genre => (
          <label>
            <input type="checkbox" data-filter="genre" value={genre} />
            {genre}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Country</h3>
        {countries.map(country => (
          <label>
            <input type="checkbox" data-filter="country" value={country} />
            {country}
          </label>
        ))}
      </div>

      <div class="filter-group">
        <h3>Platform</h3>
        {platforms.map(platform => (
          <label>
            <input type="checkbox" data-filter="platform" value={platform} />
            {platform}
          </label>
        ))}
      </div>

    </aside>

    <!-- ---- CARD GRID ---- -->
    <div class="grid-wrapper">
      <div class="grid" id="content-grid">
        {content.map((item) => (
          <ContentCard {...item} />
        ))}
      </div>

      <p class="no-results" id="no-results" style="display: none;">
        No results match your filters. Try clearing some.
      </p>
    </div>

  </div>

  <script>
    const checkboxes = document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    const cards = document.querySelectorAll<HTMLElement>('#content-grid .card');
    const clearBtn = document.getElementById('clear-filters');
    const noResults = document.getElementById('no-results');

    function applyFilters() {
      const active: Record<string, string[]> = {};

      checkboxes.forEach(checkbox => {
        if (checkbox.checked) {
          const category = checkbox.dataset.filter;
          const value = checkbox.value;

          if (category) {
            if (!active[category]) active[category] = [];
            active[category].push(value);
          }
        }
      });

      let visibleCount = 0;

      cards.forEach(card => {
        const matches = Object.entries(active).every(([category, selectedValues]) => {
          const cardValue = card.dataset[category] || '';
          const cardValues = cardValue.split(',');
          return selectedValues.some((val: string) => cardValues.includes(val));
        });

        const noFiltersActive = Object.keys(active).length === 0;

        if (noFiltersActive || matches) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    checkboxes.forEach(checkbox => {
      checkbox.addEventListener('change', applyFilters);
    });

    clearBtn?.addEventListener('click', () => {
      checkboxes.forEach(checkbox => {
        checkbox.checked = false;
      });
      applyFilters();
    });
  </script>

</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .page-header-content h1 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-bg);
    font-family: var(--font-heading); /* Use the display font for the header */

  }

  .page-header-content p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: #aaaaaa;
  }

  .content-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    align-items: start;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 88px;
  }

  #clear-filters {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    cursor: pointer;
    color: var(--color-muted);
    font-family: var(--font-body);
    transition: all 0.2s;
    width: fit-content;
  }

  #clear-filters:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-group h3 {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }

  .filter-group label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .filter-group input[type="checkbox"] {
    accent-color: var(--color-accent);
    width: 14px;
    height: 14px;
    cursor: pointer;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .no-results {
    color: var(--color-muted);
    font-size: 0.9rem;
    padding: 2rem 0;
  }

  @media (max-width: 768px) {
    .content-layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .filter-group {
      min-width: 140px;
    }
  }
</style>